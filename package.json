{
  "name": "wingosy-launcher",
  "private": true,
  "version": "0.0.111",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:debug": "bun scripts/dev-debug.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "build:windows": "bun run build && tauri build",
    "lint": "bun run lint:frontend && bun run lint:rust",
    "lint:frontend": "eslint src",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets --all-features -- -D warnings",
    "typecheck": "tsc --project jsconfig.json",
    "icons:extract": "bun scripts/extract-console-icons.mjs",
    "icons:windows": "bun scripts/generate-windows-icons.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "wdio run wdio.conf.js",
    "test:e2e:setup": "wdio run wdio.conf.js --spec e2e-webdriver/setup-wizard.spec.js",
    "test:e2e:app": "wdio run wdio.conf.js --spec e2e-webdriver/app.spec.js",
    "test:e2e:settings": "wdio run wdio.conf.js --spec e2e-webdriver/settings.spec.js",
    "test:e2e:sensing": "wdio run wdio.conf.js --spec e2e-webdriver/emulator-sensing.spec.js",
    "test:e2e:download": "wdio run wdio.conf.js --spec e2e-webdriver/emulator-download.spec.js",
    "test:e2e:cores": "wdio run wdio.conf.js --spec e2e-webdriver/retroarch-cores.spec.js",
    "test:e2e:roms": "wdio run wdio.conf.js --spec e2e-webdriver/rom-download.spec.js",
    "test:e2e:games": "wdio run wdio.conf.js --spec e2e-webdriver/game-launch.spec.js",
    "test:e2e:gba": "wdio run wdio.conf.js --spec e2e-webdriver/game-launch-gba.spec.js",
    "test:e2e:coverage": "wdio run wdio.conf.js --spec e2e-webdriver/coverage-analysis.spec.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "bun -e \"require('node:fs').mkdirSync('coverage/rust',{recursive:true})\" && cd src-tauri && cargo llvm-cov --workspace --lcov --output-path ../coverage/rust/lcov.info",
    "test:unit:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test -- --nocapture",
    "test:rust:unit": "cd src-tauri && cargo test --bin wingosy-launcher -- --nocapture",
    "test:rust:critical": "cd src-tauri && cargo test critical -- --nocapture",
    "test:rust:cores": "cd src-tauri && cargo test all_mapped_retroarch_core_buildbot_zips_are_valid -- --ignored --nocapture",
    "test:e2e:immersive": "wdio run wdio.conf.js --spec e2e-webdriver/immersive.spec.js",
    "version:set": "bun scripts/set-version.mjs",
    "version:bump": "bun scripts/bump-version.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.93",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.31.2",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "edgedriver": "^6.3.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
